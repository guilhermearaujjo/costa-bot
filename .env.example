# ---------------------------------------------------------------
# costa-bot — variaveis de ambiente
# Copie para .env (local) ou cole no painel do EasyPanel.
# ---------------------------------------------------------------

# Porta do servico
PORT=3000

# --- MODO DE OPERACAO -------------------------------------------
# mudo   = le tudo, grava tudo, NAO envia nenhuma mensagem.
#          Usar nos primeiros 1-2 dias. E a trava principal.
# piloto = so responde os numeros da WHITELIST.
# ativo  = responde todo contato novo.
MODO=mudo

# Numeros liberados no modo piloto (formato internacional, sem + e sem espacos)
# Ex.: 5515999998888,5511988887777
WHITELIST=

# --- EVOLUTION API ----------------------------------------------
EVOLUTION_URL=https://api.seudominio.com.br
EVOLUTION_APIKEY=troque-isto
EVOLUTION_INSTANCE=costa

# Segredo que vai na URL do webhook. A Evolution deve chamar:
# https://<host-do-bot>/webhook/<WEBHOOK_TOKEN>
WEBHOOK_TOKEN=troque-isto-tambem

# --- BANCO ------------------------------------------------------
DATABASE_URL=postgres://usuario:senha@host:5432/costabot

# --- REGRAS DE NEGOCIO ------------------------------------------
# Quantidade minima em kg que separa lead de venda no varejo.
# PENDENTE: confirmar com o Anderson.
MINIMO_KG=25

# Anuncios do Mercado Livre. Usados SO no caminho "bastao abaixo do minimo".
# Nao existe anuncio de granulado: quem pede granulado abaixo do minimo
# vai para atendimento humano, nao recebe link.
LINK_ML_BASTAO_11MM=https://www.mercadolivre.com.br/bastao-de-cola-quente-11mm-x-30cm-1kg/up/MLBU5521741081
LINK_ML_BASTAO_74MM=https://www.mercadolivre.com.br/bastao-de-cola-quente-74mm-x-30cm-1kg/up/MLBU5593342565

# --- COMPORTAMENTO HUMANO ---------------------------------------
# Atraso aleatorio antes de cada resposta, em milissegundos.
DELAY_MIN_MS=2000
DELAY_MAX_MS=6000

# Nao responder de novo o mesmo contato dentro desse prazo (horas).
JANELA_SAUDACAO_HORAS=72

# Token para as rotas administrativas (/admin/*)
ADMIN_TOKEN=troque-isto-3
